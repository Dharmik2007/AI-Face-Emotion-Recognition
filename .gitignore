__pycache__/
*.py[cod]
*$py.class
*.so

# Cpython & Pytest caches
.pytest_cache/
.coverage
htmlcov/
.cache/

# Node & package manager dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
