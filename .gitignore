dataset/fer2013.csv
dataset/*.tar.gz
dataset/*.zip
dataset/*.rar
dataset/*.7z

# Video sequence datasets & personal recordings
dataset/videos/*.mp4
dataset/videos/*.avi
dataset/videos/*.mov
dataset/videos/*.mkv
recordings/
uploads/

# Logs & temporary files
*.log
*.tmp
*.bak
*.swp
*~

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

